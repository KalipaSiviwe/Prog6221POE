<Window x:Class="CyberBuddy1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberBuddy — Cybersecurity Awareness"
        Height="720" Width="1040"
        MinHeight="560" MinWidth="880"
        Background="{StaticResource BrushBgDeep}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ASCII art panel (Task 1 integration) -->
        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
            Background="{StaticResource BrushPanel}"
            CornerRadius="8" Padding="12" Margin="0,0,12,0"
            BorderBrush="{StaticResource BrushAccent}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="CyberBuddy"
                     Foreground="{StaticResource BrushAccentDim}"
                     FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock x:Name="AsciiText"
                     Foreground="{StaticResource BrushAccent}"
                     FontFamily="Consolas"
                     FontSize="10"
                     TextWrapping="Wrap" />
                    <TextBlock Text="Stay alert. Stay secure."
                     Foreground="{StaticResource BrushText}"
                     FontSize="12"
                     Margin="0,12,0,0"
                     TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Header -->
        <Border Grid.Row="0" Grid.Column="1"
            Background="{StaticResource BrushPanel}"
            CornerRadius="8" Padding="16" Margin="0,0,0,12"
            BorderBrush="{StaticResource BrushAccent}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Cybersecurity chat"
                   Foreground="{StaticResource BrushAccentDim}"
                   FontSize="22" FontWeight="Bold" />
                <TextBlock Text="Ask about passwords, scams, privacy, phishing, malware, or safe browsing. Say 'help' or 'exit'."
                   Foreground="{StaticResource BrushText}"
                   FontSize="13"
                   Margin="0,6,0,0"
                   TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Chat log -->
        <Border Grid.Row="1" Grid.Column="1"
            Background="{StaticResource BrushPanel}"
            CornerRadius="8" Padding="0"
            BorderBrush="{StaticResource BrushAccentDim}" BorderThickness="1">
            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="12">
                <StackPanel x:Name="ChatPanel" />
            </ScrollViewer>
        </Border>

        <!-- Input row -->
        <Grid Grid.Row="2" Grid.Column="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox"
               Grid.Column="0"
               MinHeight="44"
               FontSize="14"
               Padding="10"
               VerticalContentAlignment="Center"
               Background="#0D1B2A"
               Foreground="{StaticResource BrushText}"
               BorderBrush="{StaticResource BrushAccent}"
               BorderThickness="1"
               KeyDown="InputBox_KeyDown" />
            <Button x:Name="SendButton"
              Grid.Column="1"
              Content="Send"
              MinWidth="100"
              Margin="12,0,0,0"
              Padding="16,10"
              FontSize="14"
              FontWeight="SemiBold"
              Background="{StaticResource BrushAccent}"
              Foreground="#0D1B2A"
              BorderThickness="0"
              Cursor="Hand"
              Click="SendButton_Click" />
        </Grid>
    </Grid>
</Window>
