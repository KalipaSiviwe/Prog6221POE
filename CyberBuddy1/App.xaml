<Application x:Class="CyberBuddy1.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BrushBgDeep" Color="#0D1B2A" />
        <SolidColorBrush x:Key="BrushPanel" Color="#1B263B" />
        <SolidColorBrush x:Key="BrushAccent" Color="#00B4D8" />
        <SolidColorBrush x:Key="BrushAccentDim" Color="#48CAE4" />
        <SolidColorBrush x:Key="BrushText" Color="#E0E1DD" />
        <SolidColorBrush x:Key="BrushUserBubble" Color="#415A77" />
        <SolidColorBrush x:Key="BrushBotBubble" Color="#243B53" />
    </Application.Resources>
</Application>
